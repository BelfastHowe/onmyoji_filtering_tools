@echo off
setlocal
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $node=Get-Command node.exe -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty Source; if (!$node) { $node=Get-AppxPackage 'OpenAI.CodexPrimaryRuntime*' | Sort-Object Version -Descending | ForEach-Object { Join-Path $_.InstallLocation 'dependencies\node\bin\node.exe' } | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1 }; if (!$node) { throw 'Node.js 24+ is required.' }; $url='http://127.0.0.1:4317'; try { $service=Invoke-RestMethod ($url+'/api/catalogue') -TimeoutSec 2 } catch { $service=$null }; if ($null -eq $service.counts) { if (!(Test-Path -LiteralPath 'dist/index.html')) { throw 'Build the frontend first: pnpm run build' }; $dir=(Get-Location).Path; $null=New-Item -Force -ItemType Directory 'local_data'; $p=Start-Process $node -ArgumentList 'app/server.ts' -WorkingDirectory $dir -WindowStyle Hidden -PassThru -RedirectStandardError (Join-Path $dir 'local_data/launcher-error.log'); for($i=0;$i -lt 20;$i++) { Start-Sleep -Milliseconds 250; if($p.HasExited) {throw 'Service failed; see local_data/launcher-error.log'}; try { $service=Invoke-RestMethod ($url+'/api/catalogue') -TimeoutSec 1; if($null -ne $service.counts){break} } catch {} }; if ($null -eq $service.counts) { throw 'Service did not respond' } }; Start-Process $url"
if errorlevel 1 pause
